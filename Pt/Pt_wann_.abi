ndtset 2
jdtset 1 2
getden -1

#DS1##############################################################################

# Basics
structure "poscar:POSCAR"
nsym 1 # Number fo SYMmetry operations (1: no sym; only indentity)
nsppol 1 # Number of SPin POLarization

nstep  40 # SCF steps
ecut   15.0 # Maximal kinetic energy cut-off, in Hartree
tolwfr 1.0d-16 # SCF convergence
occopt 7 # OCCupation OPTion (7: Gaussian)
tsmear 3000 K # Temperature of SMEARing

nband   40 # Number of BANDs
kptopt  3 # KPoinTs OPTion (3: rely on ngkpt, nshiftk and shiftk; do not consider any sym)
ngkpt   4 4 1 # K - PoinTs grid : Real space LATTice
nshiftk 1 # No shif
shiftk  0.5 0.5 0.0

# GS
nspinor 1 # Number of SPINORial components of the wavefunctions

# PAW
pawecutdg 30.0 # PAW - Energy CUToff for the Double Grid
pawprtvol 3

# File-handling
pp_dirpath "$ABI_HOME/JTH-LDA-atomicdata-1.1/ATOMICDATA/"
pseudos "Pt.LDA_PW-JTH.xml"

#DS2##############################################################################

# Basics
iscf2 -2   #nscf run
nstep2 0   #just read the old wave functions
tolwfr2 1.e-10 #dummy here
getwfk2 1
getden2 1   # Usual file handling data
prtwant2 2   # Call to Wannier90
nband2 6
istwfk2 *1 #Controls the form of the wavefunctions
kptopt2 3   # Option for the automatic generation of k points
w90prtunk2 0   #Prints UNK files (for plotting the Wannier functions)
